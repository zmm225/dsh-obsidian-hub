{
  "name": "dsh-obsidian-hub",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Connect DeepSeek Harness to an Obsidian vault: read, write, batch operations, and fast queries.",
  "license": "MIT",
  "author": "zmm225",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zmm225/dsh-obsidian-hub.git"
  },
  "homepage": "https://github.com/zmm225/dsh-obsidian-hub#readme",
  "bugs": {
    "url": "https://github.com/zmm225/dsh-obsidian-hub/issues"
  },
  "keywords": [
    "dsh-bundle",
    "deepseek-harness",
    "plugin",
    "obsidian",
    "notes",
    "knowledge-base"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "ARCHITECTURE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
